{
  "_comment": "Merge the 'hooks' and 'enabledPlugins' blocks below into your existing ~/.claude/settings.json. Keep your existing 'permissions', 'mcpServers', and other settings.",

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/sync-skills-cache.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/anti-sycophancy.py"
          }
        ]
      }
    ]
  },

  "enabledPlugins": {
    "codelabs-cofounder@codelabs": true,
    "codelabs-dev-servers@codelabs": true,
    "codelabs-advisors@codelabs": true,
    "codelabs-feature-port@codelabs": true,
    "codelabs-role-empathy@codelabs": true
  }
}
